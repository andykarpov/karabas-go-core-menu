# Timing constraints. This block is the same in karabas_go.ucf, karabas_mini.ucf and karabas_minig.ucf; the parts
# after it are those of the board (the video DAC of the Go, HDMI of the Mini / Mini G).
#
# Clocks, all from one PLL on CLK_50MHZ (VCO 600 MHz), phase 0 (rtl/karabas_*_top.v):
#   pll_clk<0> 40 MHz    clk_sys (BUFG): the audio (ADC, DACs, the HDMI samples), the reset of HDMI; the pixel clock
#                                 of 800 x 600 (BUFGMUX I1)
#   pll_clk<1>           Mini / Mini G: 8 MHz clk_8, FT_CLK_OUT; Go: 12.24 MHz MIDI_CLK
#   pll_clk<2> 75 MHz    clk_cpu: the menu CPU, the SRAM, the MCU link (kg_mcu2), the ESP and MIDI uarts
#   pll_clk<3>           Go, Mini G: 25 MHz, the pixel clock of 640 x 480 (BUFGMUX I0); Mini: 12.24 MHz MIDI_CLK
#   pll_clk<4>           Mini: 25 MHz, the pixel clock of 640 x 480
#   clk_pix              the BUFGMUX of 25 / 40 MHz (the VMODE register of the CPU): menu_video (its scanout),
#                        menu_compose, the OSD overlay, the VGA pins of the Go, HDMI of the Mini / Mini G
# The PERIOD of CLK_50MHZ is derived onto every PLL output (and the HDMI DCM). No clock comes from logic and there are
# no latches.
# ------------------------------------------------------------------------------------------------------------
NET "CLK_50MHZ" TNM_NET = "CLK_50MHZ";
TIMESPEC "TS_CLK_50MHZ" = PERIOD "CLK_50MHZ" 20 ns HIGH 50%;

NET "clk_sys" TNM_NET = "TG_CLK_SYS";
NET "pll_clk<2>" TNM_NET = "TG_CLK_CPU";
NET "clk_pix" TNM_NET = "TG_CLK_PIX";
# The pixel clock carries the derived PERIODs of both PLL outputs of the BUFGMUX, and only one of them runs at a
# time: its paths are bounded by the shorter period (40 MHz), which covers 25 MHz too; no path is timed from one
# of them to the other (a switch breaks a frame, the monitor syncs again).
TIMESPEC "TS_PIX" = FROM "TG_CLK_PIX" TO "TG_CLK_PIX" 25 ns;
# The select of the BUFGMUX (a clk_sys flip-flop of the VMODE register): a BUFGMUX switches without a glitch at any
# time of S; its setup to the input clocks only decides at which of their edges.
NET "pix_sel" TIG;
# clk_cpu (600 / 8), clk_sys (600 / 15) and the pixel clock (600 / 15 or 600 / 24) come from one VCO but have no
# common period short enough for the analysis (their nearest edges are one VCO period apart). The paths between them
# are crossings only: kg_sync toggles (the line requests of menu_video, the shown buffer, the frame, VMODE), the line
# buffer and the palette (block RAM, written on clk_cpu, read on clk_pix), the line number taken with its toggle
# (stable two clocks before it is used), the settings of the OSD overlay (taken at the start of a frame), the
# colours of menu_compose (stable while used), the audio samples and the reset into HDMI (toggles, two
# flip-flops): their data paths are bounded by one clk_cpu period, those from clk_sys by one pixel clock period.
TIMESPEC "TS_CPU_TO_SYS" = FROM "TG_CLK_CPU" TO "TG_CLK_SYS" 13.3 ns DATAPATHONLY;
TIMESPEC "TS_SYS_TO_CPU" = FROM "TG_CLK_SYS" TO "TG_CLK_CPU" 13.3 ns DATAPATHONLY;
TIMESPEC "TS_CPU_TO_PIX" = FROM "TG_CLK_CPU" TO "TG_CLK_PIX" 13.3 ns DATAPATHONLY;
TIMESPEC "TS_PIX_TO_CPU" = FROM "TG_CLK_PIX" TO "TG_CLK_CPU" 13.3 ns DATAPATHONLY;
TIMESPEC "TS_SYS_TO_PIX" = FROM "TG_CLK_SYS" TO "TG_CLK_PIX" 25 ns DATAPATHONLY;
TIMESPEC "TS_PIX_TO_SYS" = FROM "TG_CLK_PIX" TO "TG_CLK_SYS" 25 ns DATAPATHONLY;

# The SRAM (menu_sram, 10 ns): MA / MWR_N / MRD_N / MD out of IOB flip-flops on clk_cpu, MD into an IOB flip-flop
# at the end of a two-clock read (26.7 ns: the 8 ns out, 10 ns of the SRAM, 4 ns in), as doom_sram.
TIMEGRP "TG_SRAM_IN" = PADS("MD<*>");
TIMEGRP "TG_SRAM_OUT" = "TG_SRAM_IN" PADS("MA<*>") PADS("MWR_N<*>") PADS("MRD_N<*>");
TIMESPEC "TS_SRAM_OUT" = FROM FFS TO "TG_SRAM_OUT" 8 ns DATAPATHONLY;
TIMESPEC "TS_SRAM_IN" = FROM "TG_SRAM_IN" TO FFS 4 ns DATAPATHONLY;

# MCU link (kg_mcu): SPI mode 0 from the RP2040 at 16 MHz (bursts would go at that speed too, BURST_MAX_MHZ 0);
# bounded at 32 MHz as in the other cores.
NET "MCU_SCK" TNM_NET = "TG_CLK_MCU";
TIMESPEC "TS_CLK_MCU" = PERIOD "TG_CLK_MCU" 32 MHz;
# MCU_SCK is not related to CLK_50MHZ, the PERIODs do not cover the paths between it and clk_sys. kg_mcu crosses
# with toggle synchronisers (2-3 flip-flops) and holds the data registers for 8 SCK periods (a received byte)
# or from the request to the next SCK edges (a reply word): their data paths are bounded by one SCK period.
TIMESPEC "TS_MCU_TO_SYS" = FROM "TG_CLK_MCU" TO "TG_CLK_SYS" 31.25 ns DATAPATHONLY;
TIMESPEC "TS_SYS_TO_MCU" = FROM "TG_CLK_SYS" TO "TG_CLK_MCU" 31.25 ns DATAPATHONLY;
# Mini G: kg_mcu2 on clk_cpu, the same bounds
TIMESPEC "TS_MCU_TO_CPU" = FROM "TG_CLK_MCU" TO "TG_CLK_CPU" 31.25 ns DATAPATHONLY;
TIMESPEC "TS_CPU_TO_MCU" = FROM "TG_CLK_CPU" TO "TG_CLK_MCU" 31.25 ns DATAPATHONLY;

# ---- Mini, Mini G: HDMI ----------------------------------------------------------------------------------------
# hdmi_pll: DCM_SP makes the 5x serial clock of clk_pix (125 / 200 MHz). The TMDS words (OUTPUT_REG of hdmi_tx,
# pixel clock) -> the 5x shift registers of the serializers: in 800 x 600 they have 5 ns minus the skew and the
# uncertainty; the bound makes PAR keep them short (it only tightens). The load phase of the serializer is set by
# its reset, not by the pixel clock: no multicycle. FT_CLK and the FT812 video pins are not used (no FT812 video
# in the boot core).
INST "hdmi_top/hdmi_tx/ser_d_*" TNM = "TG_SER_D";
INST "hdmi_top/hdmi_tx/chn*shift_r_*" TNM = "TG_SER_SHIFT";
TIMESPEC "TS_SER_D" = FROM "TG_SER_D" TO "TG_SER_SHIFT" 3.5 ns DATAPATHONLY;
